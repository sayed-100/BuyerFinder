# BuyerFinder Environment Configuration
# Copy this file to .env.local and populate with your credentials.

# Google Places API (New) Key for real-time US business discovery
GOOGLE_PLACES_API_KEY=

# Set to "true" to enable live external APIs; set to "false" to use isolated development mock data
ENABLE_REAL_APIS=false

# Google OAuth 2.0 Credentials for sending outreach via user's own Gmail account
# Create in Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server-side AES-256-GCM encryption key for the sealed httpOnly session cookie
# (Optional; defaults to deriving from GOOGLE_OAUTH_CLIENT_SECRET if omitted)
GMAIL_SESSION_SECRET=

